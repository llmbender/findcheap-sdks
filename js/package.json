  },
  "keywords": ["findcheap", "price comparison", "shopping", "agents", "product search"],
  "homepage": "https://findcheap.ai/developers",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
