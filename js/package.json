{
  "name": "findcheap",
  "version": "0.1.0",
  "description": "Find where the product on a page is sold for less: the Findcheap API's search, extract and resolve calls.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist", "README.md"],
  "engines": { "node": ">=18" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/client.test.ts",
